{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cycle": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CONTINUE",
        "NEEDS_USER",
        "BLOCKED",
        "DONE"
      ]
    },
    "summary": {
      "type": "string"
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "command",
          "result",
          "evidence"
        ]
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nextAction": {
      "type": "string"
    },
    "userAction": {
      "type": "string"
    },
    "needsSketchupValidation": {
      "type": "boolean"
    }
  },
  "required": [
    "cycle",
    "status",
    "summary",
    "changedFiles",
    "tests",
    "blockers",
    "nextAction",
    "userAction",
    "needsSketchupValidation"
  ]
}
