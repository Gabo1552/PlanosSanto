{
  "name": "planos-santo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "python3 scripts/package-rbz.py && npm run build:offline && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run test:ruby && npm run test && npm run build && npm run typecheck && npm run test:e2e && npm run test:offline:ruby && npm run test:offline:ui && python3 scripts/package-rbz.py",
    "test:ruby": "node scripts/test-ruby.mjs --transport",
    "package:rbz": "npm run test:ruby && python3 scripts/package-rbz.py",
    "predev": "python3 scripts/package-rbz.py && npm run build:offline",
    "verify:real": "tsx scripts/verify-real-export.ts",
    "verify:real:workflow": "tsx scripts/verify-real-workflow.ts",
    "build:offline": "node scripts/build-offline.mjs",
    "test:offline:ruby": "node scripts/test-offline-ruby.mjs",
    "test:offline:ui": "playwright test --config playwright.offline.config.ts",
    "verify:offline": "npm run build:offline && npm run test:offline:ruby && npm run test:offline:ui",
    "verify:offline:real": "tsx scripts/verify-offline-real.ts",
    "preview:offline:real": "tsx scripts/preview-offline-real.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "next": "^15.5.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "yauzl": "^3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@types/yauzl": "^3.4.0",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
