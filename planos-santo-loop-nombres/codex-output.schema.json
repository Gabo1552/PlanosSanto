{
  "$schema": "https://json-schema.org/draft/2020-12/schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "working",
        "needs_user",
        "blocked",
        "done"
      ]
    },
    "phase": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_step": {
      "type": "string"
    },
    "manual_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "state",
    "phase",
    "summary",
    "changed_files",
    "tests",
    "next_step",
    "manual_checks"
  ]
}
